# ── Helpdesk AI — variables d'environnement ───────────────────────────────────
# Copier ce fichier vers .env (jamais committé) et adapter les valeurs.

# ── Avant tout demarrage ──────────────────────────────────────────────────────
# Les trois valeurs marquees REMPLACER__ doivent etre generees avant la mise en
# service. Le service refuse de demarrer tant qu'elles sont inchangees.
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Ne jamais committer le fichier .env qui en resulte : il est ignore par Git.
# En integration continue, ces valeurs passent par les secrets du depot.


# JWT — Clé secrète (minimum 32 caractères aléatoires)
SECRET_KEY=REMPLACER__32_caracteres_aleatoires_minimum
ALGORITHM=HS256
TOKEN_EXPIRE_MIN=480

# Base de données — PostgreSQL (service "postgres" du docker-compose)
DB_URL=postgresql+psycopg2://helpdesk:REMPLACER__mot_de_passe_de_la_base@postgres:5432/helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=REMPLACER__mot_de_passe_de_la_base
POSTGRES_DB=helpdesk

# Classification — seuil de confiance auto-routage
CONFIDENCE_THRESHOLD=0.40

# Emails des administrateurs (séparés par des virgules)
ADMIN_EMAILS=mohamedaminetoukabri089@gmail.com

# CORS — origines autorisées pour le frontend (séparées par des virgules)
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# API key pour l'endpoint /ingest (Power Automate)
INGEST_API_KEY=REMPLACER__cle_du_connecteur_d_ingestion

# LLM local (Ollama) — synthese des tickets similaires pour l'admin, 100% on-premise
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=90.0

# ── Messagerie sortante — lien "mot de passe oublie" ──────────────────────────
# SMTP_HOST vide : aucun courriel n'est envoye. Le parcours reste utilisable en
# developpement, le lien est alors ecrit dans le journal du service (jamais en
# production). Renseigner ces valeurs pour activer l'envoi reel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=REMPLACER__mot_de_passe_du_compte_smtp
SMTP_FROM=no-reply@onetech-bs.com
SMTP_STARTTLS=true
SMTP_TIMEOUT=15.0

# Base de l'URL du frontend — sert a construire le lien envoye par courriel.
APP_BASE_URL=http://localhost:4200

# Duree de validite du lien de reinitialisation, en minutes.
RESET_TOKEN_TTL_MIN=30
