# ── Helpdesk AI — Frontend Angular ────────────────────────────────────────────
# Build multi-stage : Node 20 (build) → Nginx 1.27 (serve)
#
# Build (depuis helpdesk-ai/) :
#   docker build -f docker/Dockerfile.front -t helpdesk-front .
# ──────────────────────────────────────────────────────────────────────────────

# ── Stage 1 : Build Angular ────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Dépendances d'abord (couche cachée)
COPY frontend/package*.json ./
RUN npm ci --prefer-offline

# Code source
COPY frontend/ .

# Build de production (outputHashing activé → assets immuables)
RUN npm run build

# ── Stage 2 : Serveur Nginx ────────────────────────────────────────────────────
FROM nginx:1.27-alpine

# SPA Angular compilée
COPY --from=builder /app/dist/frontend/browser /usr/share/nginx/html

# Configuration Nginx (SPA routing + headers sécurité)
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
