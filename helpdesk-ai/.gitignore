# Environnement
venv/
__pycache__/
*.pyc
.env

# Données (gérées par DVC)
data/raw/*
data/processed/*
data/splits/*
!data/raw/*.dvc
!data/processed/*.dvc
!data/splits/*.dvc
# Manifestes de version du dataset : métadonnées seules (empreinte, comptes,
# répartition par catégorie). Ils portent la traçabilité « quelle version du
# dataset correspond à quel modèle » et doivent donc être versionnés avec le code.
!data/splits/*.manifest.json

# Données MLOps — même régime que le corpus : le contenu reste hors git, seuls les
# manifestes y entrent. `data/reference/test_reference.csv` contient 356 tickets
# réels et 169 noms de demandeurs en clair ; `data/curated/` exporte des tickets de
# production et `data/knowledge/` des solutions rédigées par les administrateurs.
# Aucun de ces fichiers n'a sa place dans un historique git public.
data/reference/*
data/curated/*
data/knowledge/*
!data/reference/*manifest.json
!data/curated/*.manifest.json
!data/knowledge/*.manifest.json

# Données externes (benchmark public reproductible via notebook 01)
data/external/

# Modèles lourds
models/*.pkl
# Checkpoints d'entraînement CamemBERT intermédiaires (~80 Mo).
# L'adaptateur final models/camembert_lora_adapter/ reste versionné.
models/camembert_lora/
mlruns/

# Jupyter checkpoints
.ipynb_checkpoints/

# pytest-cov
.coverage

# Frontend (Node / Angular)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.angular/

# Bases de données locales (runtime)
data/*.db
data/*.sqlite*

# OS
.DS_Store