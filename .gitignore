# ===========================================
# .gitignore racine du dépôt (C:/projetpfe)
# ===========================================

# Environnements virtuels Python
/venv/
venv/
.venv/
env/

# Dépendances Node (frontend)
node_modules/

# Caches Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Modèles / artefacts lourds
*.pkl
mlruns/

# Exception : le registre de modèles. Ses .pkl sont les artefacts figés des versions
# promues, et sans eux le rollback annoncé par helpdesk-ai/MLOPS.md §3.6 ne fonctionne
# pas depuis un clone frais : l'index listerait des versions dont le modèle a disparu.
# Un pipeline pèse ~330 Ko ; si l'historique devient trop lourd, supprimer les
# répertoires des versions anciennes plutôt que de réintroduire l'exclusion.
!helpdesk-ai/models/registry/**/*.pkl

# Bases de données locales
*.db
*.sqlite
*.sqlite3

# Secrets / config locale
.env
.env.*
!.env.example

# OS / éditeurs
.DS_Store
Thumbs.db
*.swp

# Config locale Claude Code (permissions/session propres a la machine)
.claude/settings.local.json

# LaTeX — artefacts de compilation du mémoire
report/*.aux
report/*.log
report/*.toc
report/*.lof
report/*.lot
report/*.out
report/*.bbl
report/*.blg
report/*.bcf
report/*.run.xml
report/*.mtc*
report/*.maf
report/*.idx
report/*.ilg
report/*.ind
report/*.synctex.gz
report/**/*.aux

# ===========================================
# Donnees a caractere personnel et documents tiers
# ===========================================
# Ces exclusions sont volontaires et ne doivent pas etre levees.

# Corpus reel : 1 357 tickets OTBS avec noms de demandeurs, consultants,
# filiales, identifiants clients et chemin SharePoint interne. Le depot
# distribue le code, jamais les donnees. Voir README.md, section Donnees.
helpdesk-ai/models/semantic_rag/knowledge_base.parquet
helpdesk-ai/data/reference/test_reference.csv

# Memoires d'autres etudiants, conserves en local comme exemples de redaction.
# Les publier reviendrait a les rediffuser sans l'accord de leurs auteurs.
exemple_de_rapport/

# Support d'integration interne OneTech Business Solutions.
presentation_otbs/

# Fichiers de verrouillage Microsoft Office
~$*

# Journaux de travail internes : comptes rendus de session, audits de
# relecture, questions preparees pour la soutenance. Ils citent les huit
# filiales, le chemin SharePoint du service et des metriques invalidees en
# cours d'analyse, hors du contexte qui les explique.
reports/
AUDIT_FINAL_MEMOIRE.md
QUESTIONS_JURY.md
RAPPORT_FINAL_CORRECTIONS.md

# Copies de travail : captures en attente d'integration au memoire et
# diagrammes d'exemple collectes ailleurs.
captures_app/
exemples_diagrammes/

# Organigramme du service, releve sur un document interne OneTech : il nomme
# une quarantaine de salaries. La source PlantUML, l'image rendue et le memoire
# compile qui la reproduit en page 23 restent donc locaux. Un clone ne compile
# pas main.tex tant que ch01_organigramme.pdf n'est pas fourni. Pour publier le
# memoire, remplacer cette figure par une version en fonctions et effectifs,
# sans patronymes : les effectifs figurent en tete du .puml.
report/diagrams/ch01_organigramme.puml
report/img/ch01_organigramme.pdf
report/main.pdf

# ===========================================
# Artefacts lourds exclus du depot distant
# ===========================================
# GitHub refuse tout fichier au-dela de 100 Mo, et modele.onnx en pese 432.
# Le depot garde le code d'entrainement, les scripts et les metriques : le
# modele se reconstruit depuis helpdesk-ai/scripts/. L'adaptateur LoRA de
# models/camembert_servi/ reste suivi, il ne pese que 3,5 Mo et suffit a
# rejouer le modele servi avec CamemBERT telecharge depuis Hugging Face.
helpdesk-ai/models/camembert_onnx/
helpdesk-ai/models/_camembert_servi_travail/
helpdesk-ai/models/_validation_travail/

# Captures video de demonstration, hors sujet pour un depot de code.
videos/

# Organigramme nominatif du service, ecarte du memoire : il nomme une
# quarantaine de salaries d'OTBS. Conserve en local, jamais publie.
report/img/_ecartees/ch01_organigramme.png
