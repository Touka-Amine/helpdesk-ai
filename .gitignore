# Environnements virtuels Python
/venv/
venv/
.venv/
env/

# Dépendances Node (frontend)
node_modules/

# Caches Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Modèles / artefacts lourds
*.pkl
mlruns/

# Bases de données locales
*.db
*.sqlite
*.sqlite3

# Secrets / config locale
.env
.env.*
!.env.example

# OS / éditeurs
.DS_Store
Thumbs.db
*.swp

# Config locale Claude Code (permissions/session propres a la machine)
.claude/settings.local.json
