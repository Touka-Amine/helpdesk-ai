# ===========================================
# .gitignore racine du dépôt (C:/projetpfe)
# ===========================================

# Environnements virtuels Python
/venv/
venv/
.venv/
env/

# Dépendances Node (frontend)
node_modules/

# Caches Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Modèles / artefacts lourds
*.pkl
mlruns/

# Exception : le registre de modèles. Ses .pkl sont les artefacts figés des versions
# promues, et sans eux le rollback annoncé par helpdesk-ai/MLOPS.md §3.6 ne fonctionne
# pas depuis un clone frais : l'index listerait des versions dont le modèle a disparu.
# Un pipeline pèse ~330 Ko ; si l'historique devient trop lourd, supprimer les
# répertoires des versions anciennes plutôt que de réintroduire l'exclusion.
!helpdesk-ai/models/registry/**/*.pkl

# Bases de données locales
*.db
*.sqlite
*.sqlite3

# Secrets / config locale
.env
.env.*
!.env.example

# OS / éditeurs
.DS_Store
Thumbs.db
*.swp

# Config locale Claude Code (permissions/session propres a la machine)
.claude/settings.local.json

# LaTeX — artefacts de compilation du mémoire
report/*.aux
report/*.log
report/*.toc
report/*.lof
report/*.lot
report/*.out
report/*.bbl
report/*.blg
report/*.bcf
report/*.run.xml
report/*.mtc*
report/*.maf
report/*.idx
report/*.ilg
report/*.ind
report/*.synctex.gz
report/**/*.aux

# ===========================================
# Donnees a caractere personnel et documents tiers
# ===========================================
# Ces exclusions sont volontaires et ne doivent pas etre levees.

# Corpus reel : 1 357 tickets OTBS avec noms de demandeurs, consultants,
# filiales, identifiants clients et chemin SharePoint interne. Le depot
# distribue le code, jamais les donnees. Voir README.md, section Donnees.
helpdesk-ai/models/semantic_rag/knowledge_base.parquet
helpdesk-ai/data/reference/test_reference.csv

# Memoires d'autres etudiants, conserves en local comme exemples de redaction.
# Les publier reviendrait a les rediffuser sans l'accord de leurs auteurs.
exemple_de_rapport/

# Support d'integration interne OneTech Business Solutions.
presentation_otbs/

# Fichiers de verrouillage Microsoft Office
~$*
