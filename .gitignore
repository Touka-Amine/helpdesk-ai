# ===========================================
# .gitignore racine du dépôt (C:/projetpfe)
# ===========================================

# Environnements virtuels Python
/venv/
venv/
.venv/
env/

# Dépendances Node (frontend)
node_modules/

# Caches Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Modèles / artefacts lourds
*.pkl
mlruns/

# Exception : le registre de modèles. Ses .pkl sont les artefacts figés des versions
# promues, et sans eux le rollback annoncé par helpdesk-ai/MLOPS.md §3.6 ne fonctionne
# pas depuis un clone frais : l'index listerait des versions dont le modèle a disparu.
# Un pipeline pèse ~330 Ko ; si l'historique devient trop lourd, supprimer les
# répertoires des versions anciennes plutôt que de réintroduire l'exclusion.
!helpdesk-ai/models/registry/**/*.pkl

# Bases de données locales
*.db
*.sqlite
*.sqlite3

# Secrets / config locale
.env
.env.*
!.env.example

# OS / éditeurs
.DS_Store
Thumbs.db
*.swp

# Config locale Claude Code (permissions/session propres a la machine)
.claude/settings.local.json

# LaTeX — artefacts de compilation du mémoire
report/*.aux
report/*.log
report/*.toc
report/*.lof
report/*.lot
report/*.out
report/*.bbl
report/*.blg
report/*.bcf
report/*.run.xml
report/*.mtc*
report/*.maf
report/*.idx
report/*.ilg
report/*.ind
report/*.synctex.gz
report/**/*.aux
